{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yaf-db",
      // 不要把 database_id 提交到 main：安装时由 docs/AGENT-INSTALL.md 写在自己的 deploy 分支上
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI：向量（bge-m3）、洞察模型。本地开发也走远程
  "ai": { "binding": "AI", "remote": true },
  // 语义检索：1024 维 cosine；metadata.userId 已建过滤索引
  // 本地开发同样连线上索引（Vectorize 没有本地模拟），按 userId 过滤，互不影响
  "vectorize": [{ "binding": "VECTORS", "index_name": "yaf-memos", "remote": true }],
  // 每 15 分钟：启动到期的洞察计划、补算缺失的向量
  "triggers": { "crons": ["*/15 * * * *"] },
  "workflows": [
    // 存量 memo 分批补算向量 / 重建索引
    { "name": "yaf-index", "binding": "INDEX_WORKFLOW", "class_name": "IndexWorkflow" },
    // 洞察生成：取材料 → 聚类 → 分簇总结 → 汇总 → 校验引用
    { "name": "yaf-insight", "binding": "INSIGHT_WORKFLOW", "class_name": "InsightWorkflow" }
  ],
  // 微信：每个绑定一个 DO 实例，用 alarm 长轮询 getupdates
  "durable_objects": { "bindings": [{ "name": "WECHAT", "class_name": "WechatBridge" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WechatBridge"] }],
  // R2：微信图片 / 语音原文件
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "yaf-media" }],
  "vars": {
    // 模型请求经过账户的 AI Gateway（日志、缓存、限流）；留空则直连
    "AI_GATEWAY_ID": "default"
  }
  // secret：ENCRYPTION_KEY（加密用户的 Claude API key）、SETUP_TOKEN、CF_ACCOUNT_ID + CF_ANALYTICS_TOKEN + AI_PLAN（AI 用量用，见 README）。用户自己的设置都放 secret 或 deploy 分支，不改 main
}
